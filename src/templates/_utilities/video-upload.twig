{% import "_includes/forms" as forms %}

{% if volumeOptions is empty %}

    <p class="warning with-icon">
        {{ "No volumes are configured for Bunny Stream, or you don’t have permission to upload to them. Volumes are mapped to video libraries with the volumeVideoLibraries setting in config/_bunnymate.php."|t('_bunnymate') }}
    </p>

{% else %}

    <div id="bunnymate-uploader">

        {{ forms.selectField({
            label: "Volume"|t('_bunnymate'),
            instructions: "Which volume the videos should be added to."|t('_bunnymate'),
            id: 'bunnymate-volume',
            name: 'folderId',
            options: volumeOptions,
        }) }}

        <div class="bunnymate-dropzone" data-bunnymate-dropzone>
            <p>{{ "Drop video files here"|t('_bunnymate') }}</p>
            <button type="button" class="btn" data-bunnymate-browse>{{ "Choose files"|t('_bunnymate') }}</button>
            <input type="file" accept="video/*" multiple class="hidden" data-bunnymate-file-input>
        </div>

        <div class="bunnymate-upload-list" data-bunnymate-list></div>

    </div>

    {% js %}
        (function () {
            var $container = $('#bunnymate-uploader');
            var $volume = $('#bunnymate-volume');
            var uploader = new Craft.BunnyMate.Uploader($container, {
                folderId: $volume.val(),
            });
            $volume.on('change', function () {
                uploader.settings.folderId = $(this).val();
            });
        })();
    {% endjs %}

{% endif %}
