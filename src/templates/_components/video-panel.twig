{% import "_includes/forms" as forms %}

<div id="bunnymate-video-panel" data-asset-id="{{ asset.id }}">

    <div class="data">
        <div class="heading">{{ "Status"|t('_bunnymate') }}</div>
        <div class="value">
            <span class="status {{ video.status.indicatorClass() }}"></span>
            {{ video.status.label() }}
            {%- if not video.isReady and not video.isFailed and video.encodeProgress %}
                ({{ video.encodeProgress }}%)
            {%- endif %}
        </div>
    </div>

    {% if video.availableResolutions %}
        <div class="data">
            <div class="heading">{{ "Resolutions"|t('_bunnymate') }}</div>
            <div class="value">{{ video.availableResolutions|join(', ') }}</div>
        </div>
    {% endif %}

    {% if video.width and video.height %}
        <div class="data">
            <div class="heading">{{ "Dimensions"|t('_bunnymate') }}</div>
            <div class="value">{{ video.width }} &times; {{ video.height }}</div>
        </div>
    {% endif %}

    {% if video.length %}
        <div class="data">
            <div class="heading">{{ "Duration"|t('_bunnymate') }}</div>
            <div class="value">{{ video.length }}s</div>
        </div>
    {% endif %}

    <div class="data">
        <div class="heading">{{ "Video ID"|t('_bunnymate') }}</div>
        <div class="value"><code style="font-size: 0.75em;">{{ video.videoGuid }}</code></div>
    </div>

    {% if not static %}
        <div style="margin-top: 0.75rem;">
            {# No name attribute: this lives inside Craft's element form #}
            <button type="button" class="btn" id="bunnymate-refresh-video">
                {{ "Refresh from Bunny"|t('_bunnymate') }}
            </button>
            <div class="spinner hidden" id="bunnymate-refresh-spinner"></div>
        </div>
    {% endif %}

</div>
