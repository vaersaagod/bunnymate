{# The id sits on the fieldset so the whole panel can be swapped out after a refresh #}
<fieldset id="bunnymate-video-panel" data-asset-id="{{ asset.id }}">

    <legend class="h6">{{ "Bunny Stream"|t('_bunnymate') }}</legend>

    {# Plain `.meta`, not `.meta read-only`: this is the filled card treatment #}
    <div class="meta">

        {{ fields|raw }}

        {% if not static %}
            <div class="field">
                <div class="input ltr">
                    <div class="flex flex-nowrap">
                        {# No name attribute: this panel lives inside Craft's element form #}
                        <button type="button" class="btn small" id="bunnymate-refresh-video">
                            {{ "Refresh"|t('_bunnymate') }}
                        </button>
                        <div class="spinner hidden" id="bunnymate-refresh-spinner"></div>
                    </div>
                </div>
            </div>
        {% endif %}

    </div>

</fieldset>

{# A sibling, not nested: Craft styles sidebar legends with `.details > fieldset > legend` #}
{% if not static and (originalUrl or renditions) %}
    <fieldset id="bunnymate-video-downloads">

        <legend class="h6">{{ "Downloads"|t('_bunnymate') }}</legend>

        <div class="meta">
            <div class="field">
                <div class="input ltr">
                    <div class="flex" style="flex-wrap: wrap; gap: var(--xs);">

                        {% if originalUrl %}
                            <a class="btn small" href="{{ originalUrl }}" download>
                                {{ "Original"|t('_bunnymate') }}
                                {%- if originalSize %} ({{ originalSize|filesize }}){% endif %}
                            </a>
                        {% endif %}

                        {% for resolution, url in renditions %}
                            <a class="btn small" href="{{ url }}" download>{{ resolution }}</a>
                        {% endfor %}

                    </div>
                </div>
            </div>
        </div>

    </fieldset>
{% endif %}
